# Example names only — never commit real values. See DECISIONS.md for why
# each choice below was made.

# --- App ---
DATABASE_URL=
APP_URL=
AUTH_SECRET=
ENCRYPTION_KEY=

# Comma-separated allow-list. Google OAuth sign-in succeeds only for these
# exact emails — everyone else is rejected at the NextAuth signIn callback.
ALLOWED_ADMIN_EMAILS=you@example.com

# --- Google OAuth (admin login to this app, NOT the GCP monitoring identity) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Cloud (monitoring/discovery/budget connector) ---
# Prefer leaving GOOGLE_APPLICATION_CREDENTIALS unset in production and using
# the Cloud Run service's attached service account (workload identity)
# instead — see DECISIONS.md "GCP credential strategy". Set it only for local
# development against a downloaded key.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ORG_ID=
GOOGLE_BILLING_ACCOUNT_IDS=
# Billing export is configured PER billing account in Google's own console
# (spec §5.3) — one org with multiple billing accounts needs one entry per
# account here: billingAccountId:exportProjectId:datasetId, comma-separated.
GOOGLE_BILLING_EXPORT_LOCATIONS=
# Fallback default used only for a billing account with no entry above —
# fine for the common single-billing-account case.
GOOGLE_BILLING_EXPORT_PROJECT_ID=
GOOGLE_BILLING_DATASET_ID=
REPORTING_TIMEZONE=Asia/Jerusalem

# Comma-separated. Emails of the service account(s) Cloud Scheduler/Pub-Sub
# use to invoke /api/internal/* with an OIDC token — see
# lib/auth/verify-internal.ts. These endpoints bypass admin-session auth
# entirely, so an empty value here means "reject every internal request",
# not "allow all" — see the fail-closed comment in that file.
CLOUD_SCHEDULER_SERVICE_ACCOUNT_EMAILS=

# --- OpenAI (Admin API) ---
OPENAI_ADMIN_KEY=

# --- Anthropic (Admin API) ---
ANTHROPIC_ADMIN_KEY=

# --- Email alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
