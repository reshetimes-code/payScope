{
  "name": "cost-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-tenant dashboard for monitoring and budget-limiting Google Cloud / Gemini / OpenAI / Anthropic spend. Read + limit only — never touches payment processing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.1",
    "@google-cloud/billing": "^4.3.0",
    "@google-cloud/billing-budgets": "^7.0.0",
    "@google-cloud/pubsub": "^6.0.0",
    "@google-cloud/resource-manager": "^5.3.0",
    "@google-cloud/run": "^1.5.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "google-auth-library": "^9.15.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
